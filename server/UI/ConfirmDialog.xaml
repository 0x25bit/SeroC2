<Window x:Class="SeroServer.UI.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="410" Height="185"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1" Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: optional icon glyph + title -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IconGlyph" Grid.Column="0"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="17" Margin="0,0,11,0"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="TxtTitle" Grid.Column="1"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleTextBrush}"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Message -->
            <TextBlock x:Name="TxtMessage" Grid.Row="1"
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource ContentTextBrush}"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       Margin="0,0,0,22"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnNo"  Height="28" Padding="18,0" Style="{StaticResource SBtn}"     Click="No_Click"/>
                <Button x:Name="BtnYes" Height="28" Padding="18,0" Margin="8,0,0,0" Style="{StaticResource SRedBtn}" Click="Yes_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
